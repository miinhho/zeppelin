+package example.flink;
+
+import example.python.PythonSession;
+
+public final class PythonAdapter {
+  private final PythonSession session = new PythonSession();
+  private final String workingDirectory;
+
+  public PythonAdapter() {
+    this(null);
+  }
+
+  public PythonAdapter(String workingDirectory) {
+    this.workingDirectory =
+        workingDirectory == null || workingDirectory.trim().isEmpty()
+            ? "."
+            : workingDirectory.trim();
+  }
+
+  public String language() {
+    return session.language();
+  }
+
+  public String workingDirectory() {
+    return workingDirectory;
+  }
+}
