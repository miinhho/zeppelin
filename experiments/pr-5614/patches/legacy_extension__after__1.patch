+package example.flink;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+
+class PythonAdapterTest {
+  @Test
+  void defaultsToCurrentDirectory() {
+    PythonAdapter adapter = new PythonAdapter();
+
+    assertEquals(".", adapter.workingDirectory());
+    assertEquals("python", adapter.language());
+  }
+
+  @Test
+  void normalizesNullAndBlankDirectoriesToCurrentDirectory() {
+    assertEquals(".", new PythonAdapter(null).workingDirectory());
+    assertEquals(".", new PythonAdapter("").workingDirectory());
+    assertEquals(".", new PythonAdapter(" \t\n ").workingDirectory());
+  }
+
+  @Test
+  void trimsConfiguredDirectoryWithoutChangingLanguage() {
+    PythonAdapter adapter = new PythonAdapter("  notebooks/my project \t");
+
+    assertEquals("notebooks/my project", adapter.workingDirectory());
+    assertEquals("python", adapter.language());
+  }
+}
