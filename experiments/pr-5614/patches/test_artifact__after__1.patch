+package example.shell;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import org.junit.jupiter.api.Test;
+
+class ShellOutputTest {
+
+  @Test
+  void deliversStdoutToInterpreterOutputSink() throws Exception {
+    ByteArrayOutputStream output = new ByteArrayOutputStream();
+    String stdout = "Hello from shell: \u03bb\n";
+
+    new ShellOutput().write(stdout, output);
+
+    assertEquals(stdout, output.toString(StandardCharsets.UTF_8));
+  }
+}
